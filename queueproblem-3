class PriorityQueue {

    int[] data;
    int[] priority;
    int size;
    int capacity;

    // Constructor
    PriorityQueue(int capacity) {
        this.capacity = capacity;
        data = new int[capacity];
        priority = new int[capacity];
        size = 0;
    }

    // Insert element
    void enqueue(int value, int p) {

        if (size == capacity) {
            System.out.println("Priority Queue is full");
            return;
        }

        data[size] = value;
        priority[size] = p;
        size++;

        System.out.println(value + " inserted with priority " + p);
    }

    // Remove highest-priority element
    int dequeue() {

        if (size == 0) {
            System.out.println("Priority Queue is empty");
            return -1;
        }

        // Find element with highest priority
        // Smaller priority number = higher priority
        int highestPriorityIndex = 0;

        for (int i = 1; i < size; i++) {
            if (priority[i] < priority[highestPriorityIndex]) {
                highestPriorityIndex = i;
            }
        }

        int value = data[highestPriorityIndex];

        // Shift elements to fill the empty position
        for (int i = highestPriorityIndex; i < size - 1; i++) {
            data[i] = data[i + 1];
            priority[i] = priority[i + 1];
        }

        size--;

        return value;
    }

    // Display queue
    void display() {

        if (size == 0) {
            System.out.println("Priority Queue is empty");
            return;
        }

        System.out.println("Priority Queue:");

        for (int i = 0; i < size; i++) {
            System.out.println(
                "Value: " + data[i] +
                ", Priority: " + priority[i]
            );
        }
    }

    // Check if empty
    boolean isEmpty() {
        return size == 0;
    }

    // Check if full
    boolean isFull() {
        return size == capacity;
    }

    public static void main(String[] args) {

        PriorityQueue pq = new PriorityQueue(5);

        pq.enqueue(100, 3);
        pq.enqueue(200, 1);
        pq.enqueue(300, 2);
        pq.enqueue(400, 1);

        pq.display();

        System.out.println("\nRemoved: " + pq.dequeue());
        System.out.println("Removed: " + pq.dequeue());

        System.out.println("\nAfter Deletion:");
        pq.display();
    }
}
